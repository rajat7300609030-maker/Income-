rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Health check / Connection test document
    match /test/{testId} {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Persons Collection
    match /persons/{personId} {
      allow read, write: if isSignedIn() && isValidId(personId) && 
        ((resource == null && request.resource.data.userId == request.auth.uid) || 
         (resource != null && resource.data.userId == request.auth.uid));
    }

    // Income Collection
    match /income/{incomeId} {
      allow read, write: if isSignedIn() && isValidId(incomeId) && 
        ((resource == null && request.resource.data.userId == request.auth.uid) || 
         (resource != null && resource.data.userId == request.auth.uid));
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow read, write: if isSignedIn() && isValidId(expenseId) && 
        ((resource == null && request.resource.data.userId == request.auth.uid) || 
         (resource != null && resource.data.userId == request.auth.uid));
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if isSignedIn() && isValidId(paymentId) && 
        ((resource == null && request.resource.data.userId == request.auth.uid) || 
         (resource != null && resource.data.userId == request.auth.uid));
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read, write: if isSignedIn() && isValidId(transactionId) && 
        ((resource == null && request.resource.data.userId == request.auth.uid) || 
         (resource != null && resource.data.userId == request.auth.uid));
    }

    // Recycle Bin Collection
    match /recycle_bin/{binId} {
      allow read, write: if isSignedIn() && isValidId(binId) && 
        ((resource == null && request.resource.data.userId == request.auth.uid) || 
         (resource != null && resource.data.userId == request.auth.uid));
    }
  }
}
